# Server
NODE_ENV=development
PORT=3000

# Storage backend. "memory" = in-process, zero infra (dev only; lost on restart).
# "postgres" = Postgres + Redis adapters (production). With memory you can run
# the full API with just: STORE=memory AUTH_DEV_OWNER=dev pnpm dev
STORE=postgres

# Per-concern adapter selection (only used when STORE=postgres)
WORKFLOW_STORE=postgres
EVENT_STORE=postgres
CRED_STORE=postgres

# Postgres (Neon) — required by the postgres adapters
DATABASE_URL=postgres://user:pass@host/dbname
# DB driver:
#   "postgres" = postgres.js over TCP — for long-running servers (Railway, local).
#   "neon"     = Neon serverless HTTP driver — for SERVERLESS/EDGE (Vercel,
#                Cloudflare). TCP pools don't fit serverless and can hang on
#                connect; use "neon" there. Requires a Neon DATABASE_URL.
DB_DRIVER=postgres

# Auth: API keys (mint with `pnpm create-api-key --owner <id> --name <label>`).
# Dev-only bypass — sets a fixed owner and skips key checks. NEVER set in prod.
AUTH_DEV_OWNER=

# Upstash Redis — required by the KVState adapter
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Credentials encryption: 32-byte key, base64-encoded
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEY=

# Durable engine endpoint (used by the QStash dispatcher)
ENGINE_URL=http://localhost:3000/engine

# Execution dispatch: "local" runs inline (no infra) | "qstash" enqueues durable runs
DISPATCH_MODE=local
# Publishing side (dispatch, schedules, approvals): token from the Upstash console.
QSTASH_TOKEN=
# Receiving side: the /engine endpoint verifies inbound QStash requests against
# these signing keys. REQUIRED in qstash mode — without them the SDK disables
# signature verification and /engine becomes publicly invocable. From the same
# Upstash QStash console page as the token.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Local QStash dev server only (`npx @upstash/qstash-cli dev`): point the SDK at it.
# Leave unset in production.
QSTASH_URL=

# Email provider (Resend). Without a key, email.send is a dry-run.
RESEND_API_KEY=
EMAIL_FROM=automations@example.com
# For the email.smtp node, store SMTP creds via POST /credentials with type "smtp":
#   { "host": "...", "port": 587, "user": "...", "pass": "...", "from": "...", "secure": false }

# AI (ai.complete via OpenRouter). Fallback when no `openrouter` credential is set.
# Per-owner keys: POST /credentials type "openrouter" { "apiKey": "sk-or-..." }
OPENROUTER_API_KEY=

# Triggers
PUBLIC_BASE_URL=http://localhost:3000   # QStash schedule destinations point here
INTERNAL_SECRET=                         # guards /triggers/tick/* (schedule ticks)
WEBHOOK_SECRET=                          # when set, /hooks/:id requires x-signature (HMAC-SHA256)

# OAuth account connections (one Runlet-owned app per provider; each owner
# connects their own account). Callback URI = <base>/oauth/<provider>/callback.
OAUTH_REDIRECT_BASE_URL=                 # defaults to PUBLIC_BASE_URL; register this callback in the provider app
OAUTH_SUCCESS_REDIRECT=                  # where the browser lands after a successful connect
# Slack app (create at api.slack.com/apps; add <base>/oauth/slack/callback as an OAuth redirect URL):
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SCOPES=chat:write,chat:write.public   # bot scopes requested at connect time

# Observability (all optional)
LOG_LEVEL=info
AXIOM_TOKEN=                             # ship structured logs to Axiom
AXIOM_DATASET=
SLACK_ALERT_WEBHOOK=                     # failure alerts posted here
SENTRY_DSN=                              # failure alerts captured to Sentry (https://<key>@<host>/<projectId>)
