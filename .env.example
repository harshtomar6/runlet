# Server
NODE_ENV=development
PORT=3000

# Storage adapter selection (one per concern)
WORKFLOW_STORE=postgres
EVENT_STORE=postgres
CRED_STORE=postgres

# Postgres (Neon) — required by the postgres adapters
DATABASE_URL=postgres://user:pass@host/dbname

# Upstash Redis — required by the KVState adapter
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Credentials encryption: 32-byte key, base64-encoded
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEY=

# Durable engine endpoint (used by the trigger dispatcher in later milestones)
ENGINE_URL=http://localhost:3000/engine
