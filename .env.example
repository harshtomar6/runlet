# Server
NODE_ENV=development
PORT=3000

# Storage backend. "memory" = in-process, zero infra (dev only; lost on restart).
# "postgres" = Postgres + Redis adapters (production). With memory you can run
# the full API with just: STORE=memory AUTH_DEV_OWNER=dev pnpm dev
STORE=postgres

# Per-concern adapter selection (only used when STORE=postgres)
WORKFLOW_STORE=postgres
EVENT_STORE=postgres
CRED_STORE=postgres

# Postgres (Neon) — required by the postgres adapters
DATABASE_URL=postgres://user:pass@host/dbname
# DB driver: "postgres" (TCP; Node/Vercel/Railway) | "neon" (HTTP; Cloudflare Workers)
DB_DRIVER=postgres

# Auth: API keys (mint with `pnpm create-api-key --owner <id> --name <label>`).
# Dev-only bypass — sets a fixed owner and skips key checks. NEVER set in prod.
AUTH_DEV_OWNER=

# Upstash Redis — required by the KVState adapter
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Credentials encryption: 32-byte key, base64-encoded
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENC_KEY=

# Durable engine endpoint (used by the QStash dispatcher)
ENGINE_URL=http://localhost:3000/engine

# Execution dispatch: "local" runs inline (no infra) | "qstash" enqueues durable runs
DISPATCH_MODE=local
QSTASH_TOKEN=

# Email provider (Resend). Without a key, email.send is a dry-run.
RESEND_API_KEY=
EMAIL_FROM=automations@example.com

# Triggers
PUBLIC_BASE_URL=http://localhost:3000   # QStash schedule destinations point here
INTERNAL_SECRET=                         # guards /triggers/tick/* (schedule ticks)
WEBHOOK_SECRET=                          # when set, /hooks/:id requires x-signature (HMAC-SHA256)

# Observability (all optional)
LOG_LEVEL=info
AXIOM_TOKEN=                             # ship structured logs to Axiom
AXIOM_DATASET=
SLACK_ALERT_WEBHOOK=                     # failure alerts posted here
SENTRY_DSN=                              # failure alerts captured to Sentry (https://<key>@<host>/<projectId>)
